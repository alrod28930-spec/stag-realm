# Supabase Configuration (Public keys - safe to commit)
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co

# Subscription enforcement - set to "false" to treat all users as Elite tier
VITE_SUBSCRIPTION_ENFORCEMENT=true

# IMPORTANT: Never commit .env or .env.local to version control
# Copy this file to .env.local and add your actual values
# .env.local is gitignored and safe for local development

# For production builds:
# - Only public/publishable keys should be in renderer code
# - Private keys must ONLY exist in main process or backend
# - Never expose service role keys or admin secrets to renderer
